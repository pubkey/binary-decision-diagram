{
    "compilerOptions": {
        "target": "ES5",
        "ignoreDeprecations": "6.0",
        "downlevelIteration": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "sourceMap": true,
        "strictNullChecks": true,
        "noImplicitAny": true,
        "strict": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "esModuleInterop": true,
        "declaration": true,
        "types": [
            "node",
            "mocha"
        ],
        "outDir": "./dist/cjs",
        "lib": [
            "es7",
            "dom"
        ]
    },
    "formatCodeOptions": {
        "indentSize": 2,
        "tabSize": 2
    },
    "include": [
        "src",
        "test"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules/*",
        "dist",
        "src/logic-generator/logic-map-output",
        "**.txt",
        "**.json"
    ],
    "compileOnSave": false
}
